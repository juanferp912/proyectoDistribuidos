    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    mp.nombre_insumo, \n    mp.cantidad_stock, \n    mp.punto_reorden, \n    p.nombre_empresa AS proveedor,\n    p.telefono AS contacto_proveedor\nFROM materia_prima mp\nLEFT JOIN proveedores p ON mp.proveedor_id = p.id\nWHERE mp.cantidad_stock <= mp.punto_reorden;",

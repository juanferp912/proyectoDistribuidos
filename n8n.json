        "query": "SELECT \n    mp.nombre_insumo, \n    c.nombre AS categoria,\n    (mp.cantidad_stock * mp.precio_unitario) AS capital_invertido \nFROM materia_prima mp\nJOIN categorias c ON mp.categoria_id = c.id\nORDER BY capital_invertido DESC \nLIMIT 5;",
